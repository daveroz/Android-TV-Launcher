    <string name="home_service_label">Deco Launcher Home button</string>
    <string name="home_service_description">Opens Deco Launcher whenever the Google TV home screen appears, so the Home button takes you to Deco Launcher. It only watches for the Google TV home screen and doesn\'t read anything on your screen.</string>
