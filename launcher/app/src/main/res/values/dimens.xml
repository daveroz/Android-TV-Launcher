<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV overscan-safe margins (5% of 960x540dp). -->
    <dimen name="overscan_h">48dp</dimen>
    <dimen name="overscan_v">24dp</dimen>
    <!-- Worldly radii: 12 for small cards, 14 for buttons, 28 for big panels. -->
    <dimen name="card_radius">12dp</dimen>
    <dimen name="sheet_radius">28dp</dimen>
    <dimen name="card_width">176dp</dimen>
    <dimen name="card_gap">16dp</dimen>
    <!-- Where the first row of cards starts, under the hero. -->
    <dimen name="rows_top">296dp</dimen>
    <!-- How far the rows scroll before the hero has fully faded. -->
    <dimen name="hero_fade_range">160dp</dimen>
    <dimen name="hero_scrim_width">660dp</dimen>
    <dimen name="hero_art_width">620dp</dimen>
    <dimen name="hero_art_height">349dp</dimen>
    <!-- The hero's top line (title and card), clear of the top bar, which ends at about 72dp. -->
    <dimen name="hero_top">96dp</dimen>
    <!-- Card height: from hero_top to 24dp above the rows (rows_top). Covers are square,
         banners 16:9 at this height. -->
    <dimen name="hero_card_height">176dp</dimen>
    <!-- The audio visualizer's light panel: under the hero text and its "OK Open" hint (which end
         by about 226dp), above the rows (296dp), and never reaching the cover card (overscan_h +
         hero_card_height + 36dp from the right). Its height sets the cell size: 7 rows of about
         6.4dp cells, 48 columns, about 370dp wide. -->
    <dimen name="wave_top">230dp</dimen>
    <dimen name="wave_height">62dp</dimen>
    <dimen name="wave_end">260dp</dimen>
</resources>
