<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/carbon</item>
    </style>

    <!-- Menus: a glass panel over a dimmed screen. -->
    <style name="Theme.Launcher.Sheet" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/carbon</item>
    </style>

    <!-- Small labels: bold capitals, spaced out, like the markings on a piece of equipment. -->
    <style name="SectionLabel">
        <item name="android:fontFamily">@font/carbon</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- The quiet half of a label, after the hairline. -->
    <style name="SectionLabel.Quiet">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/chrome_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
