<?xml version="1.0" encoding="utf-8"?>
<!-- Which show is on: LED dashes, the current one long and lit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/led" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hairline_strong" />
        </shape>
    </item>
</selector>
