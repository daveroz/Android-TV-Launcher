<?xml version="1.0" encoding="utf-8"?>
<!-- Focused tab: Worldly's amber button gradient. Current tab: raised graphite. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient android:angle="0" android:centerColor="@color/amber_mid" android:endColor="@color/amber_deep" android:startColor="@color/amber" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/surface_hi" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
