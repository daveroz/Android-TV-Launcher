<?xml version="1.0" encoding="utf-8"?>
<!-- Amber ring: thick while a card is being moved, normal when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <stroke android:width="4dp" android:color="@color/amber_light" android:dashWidth="10dp" android:dashGap="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <stroke android:width="3dp" android:color="@color/amber" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
