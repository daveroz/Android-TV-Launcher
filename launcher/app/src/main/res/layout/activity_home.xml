<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout after the Apple TV app: full-screen art for the focused app with a big title on the left,
  a centred pill tab bar, and rows of cards along the bottom. Colours and type are Worldly's.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:clipChildren="false">

    <!-- ===== Hero: the focused app ===== -->
    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Blurred, full-screen copy of the art: gives the whole screen the app's colours. -->
        <ImageView
            android:id="@+id/hero_ambient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <com.camdeco.launcher.HeroArtView
            android:id="@+id/hero_art"
            android:layout_width="@dimen/hero_art_width"
            android:layout_height="@dimen/hero_art_height"
            android:layout_gravity="end|top"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="@dimen/hero_scrim_width"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/scrim_top" />

        <LinearLayout
            android:id="@+id/hero_text"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:layout_marginTop="104dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="44sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_soft"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hero_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/chip_bg"
                    android:maxWidth="160dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/key_ok_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/key_ok"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/key_ok_action"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/chip_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/key_hold"
                    android:textColor="@color/text_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/key_hold_action"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Home page: rows of cards ===== -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/rows_top"
        android:paddingBottom="32dp" />

    <!-- ===== Apps page: every app in a grid ===== -->
    <LinearLayout
        android:id="@+id/apps_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="96dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:text="@string/apps_title"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/apps_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:layout_marginTop="4dp"
            android:text="@string/apps_subtitle"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/overscan_h"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/overscan_h"
            android:paddingBottom="32dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:text="@string/no_apps"
        android:textColor="@color/muted"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- ===== Top bar: tabs in a pill, clock on the right ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/overscan_h"
        android:paddingTop="@dimen/overscan_v"
        android:paddingEnd="@dimen/overscan_h">

        <com.camdeco.launcher.TabBar
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/pill_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_home"
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/Tab"
                android:text="@string/tab_apps" />

            <ImageButton
                android:id="@+id/tab_settings"
                style="@style/TabIcon"
                android:contentDescription="@string/option_tv_settings"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/tab_options"
                style="@style/TabIcon"
                android:contentDescription="@string/launcher_options"
                android:src="@drawable/ic_more" />
        </com.camdeco.launcher.TabBar>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Short messages, in a Worldly pill at the bottom. -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:background="@drawable/hint_bg"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text"
        android:textSize="14sp" />
</FrameLayout>
