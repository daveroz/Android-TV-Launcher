<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout after the Apple TV app: full-screen art for the focused app with a big title on the left,
  a centred pill tab bar, and rows of cards along the bottom. Colours and type are Worldly's.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:clipChildren="false">

    <!-- ===== Hero: the focused app ===== -->
    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Apps with nothing else to show: glows of the app's own colours and the icons' grid. -->
        <com.camdeco.launcher.ColorFieldView
            android:id="@+id/hero_field"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <!-- Blurred, full-screen copy of the art: gives the whole screen the app's colours. -->
        <ImageView
            android:id="@+id/hero_ambient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <com.camdeco.launcher.HeroArtView
            android:id="@+id/hero_art"
            android:layout_width="@dimen/hero_art_width"
            android:layout_height="@dimen/hero_art_height"
            android:layout_gravity="end|top"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="@dimen/hero_scrim_width"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/scrim_top" />

        <!-- The card on the right: an album cover, or an app's banner. Its top lines up with the
             title on the left, its right edge with the screen margin (like the clock and rows), and
             it ends well above the rows. -->
        <ImageView
            android:id="@+id/hero_cover"
            android:layout_width="@dimen/hero_card_height"
            android:layout_height="@dimen/hero_card_height"
            android:layout_gravity="end|top"
            android:layout_marginTop="@dimen/hero_top"
            android:layout_marginEnd="@dimen/overscan_h"
            android:alpha="0"
            android:background="@drawable/cover_bg"
            android:elevation="18dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/hero_text"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:layout_marginTop="@dimen/hero_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_soft"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hero_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/chip_bg"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/key_ok_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/key_ok"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/key_ok_action"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hero_hold_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/chip_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="@string/key_hold"
                    android:textColor="@color/text_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_hold_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/key_hold_action"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/hero_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- TVmaze's data is CC BY-SA, so shows are credited. -->
            <TextView
                android:id="@+id/hero_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tvmaze_credit"
                android:textColor="@color/dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Home page: rows of cards =====
         focusOutFront: let Up leave the top row for the tabs (the grid keeps focus by default). -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:focusOutFront="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/rows_top"
        android:paddingBottom="32dp" />

    <!-- ===== Apps page: every app in a grid ===== -->
    <LinearLayout
        android:id="@+id/apps_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="96dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:text="@string/apps_title"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/apps_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overscan_h"
            android:layout_marginTop="4dp"
            android:text="@string/apps_subtitle"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/apps_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:focusOutFront="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/overscan_h"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/overscan_h"
            android:paddingBottom="32dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:text="@string/no_apps"
        android:textColor="@color/muted"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- ===== Top bar: tabs in a pill, clock on the right ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/overscan_h"
        android:paddingTop="@dimen/overscan_v"
        android:paddingEnd="@dimen/overscan_h">

        <com.camdeco.launcher.TabBar
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/pill_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_home"
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/Tab"
                android:text="@string/tab_apps" />

            <ImageButton
                android:id="@+id/tab_settings"
                style="@style/TabIcon"
                android:contentDescription="@string/option_tv_settings"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/tab_options"
                style="@style/TabIcon"
                android:contentDescription="@string/launcher_options"
                android:src="@drawable/ic_more" />

            <!-- Mini player: appears while music or video plays in another app. -->
            <LinearLayout
                android:id="@+id/np_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/night" />

                <LinearLayout
                    android:id="@+id/np_open"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/tab_bg"
                    android:clickable="true"
                    android:contentDescription="@string/now_playing_title"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/np_art"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/np_art_bg"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/np_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxWidth="200dp"
                        android:maxLines="1"
                        android:textColor="@color/on_amber"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/np_play"
                    style="@style/TabIcon"
                    android:contentDescription="@string/play_pause"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/np_next"
                    style="@style/TabIcon"
                    android:contentDescription="@string/next"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </com.camdeco.launcher.TabBar>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Short messages, in a Worldly pill at the bottom. -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:background="@drawable/hint_bg"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text"
        android:textSize="14sp" />
</FrameLayout>
