<?xml version="1.0" encoding="utf-8"?>
<!-- What's playing (Spotify and other media apps), as the first row on Home. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/row_title"
        style="@style/SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/overscan_h"
        android:text="@string/row_now_playing"
        android:textColor="@color/section_label" />

    <LinearLayout
        android:layout_width="@dimen/now_playing_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/overscan_h"
        android:layout_marginTop="12dp"
        android:background="@drawable/np_panel_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/np_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/np_open_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/np_art"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/card_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/np_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/np_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_soft"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/np_app"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/np_previous"
                style="@style/TabIcon"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/np_play"
                style="@style/TabIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/np_next"
                style="@style/TabIcon"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/np_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/np_progress" />
    </LinearLayout>
</LinearLayout>
